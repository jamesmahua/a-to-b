{
  "name": "a-to-b",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kk \"vitest run --config tests/rules/vitest.config.ts\"",
    "emulators": "firebase emulators:start --project demo-kk",
    "dev:customer": "turbo run dev --filter=customer",
    "dev:store": "turbo run dev --filter=store-admin",
    "dev:driver": "turbo run dev --filter=driver",
    "dev:admin": "turbo run dev --filter=super-admin",
    "dev:web": "turbo run dev --filter=web",
    "env:sync": "node scripts/sync-env.mjs",
    "seed:emulator": "tsx scripts/seed/seed.ts",
    "seed:real": "tsx scripts/seed/seed.ts --real",
    "test": "turbo run test",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project a-two-b"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@repo/types": "*",
    "@types/node": "^26.6.10",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "turbo": "^2.9.3",
    "typescript": "5.9.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
