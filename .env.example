# Copy this file to .env.local (same folder), fill it in, then run: npm run env:sync
# Values: Firebase console → Project settings → General → Your apps → Web app config.
# .env.local is git-ignored. Never commit real keys.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=a-two-b.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=a-two-b
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = use the local emulators (npm run emulators) instead of the real project.
EXPO_PUBLIC_USE_EMULATORS=false
# Testing on a real phone against the emulators? Put your PC's Wi-Fi IP here (ipconfig).
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
